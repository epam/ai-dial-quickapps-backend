{
  "server": {
    "port": 8080
  },
  "identityProviders": {
    "test": {
      "rolePath": "roles",
      "disableJwtVerification": true
    },
    "keycloak": {
      "jwksUrl": "http://keycloak:8080/realms/dial-dev/protocol/openid-connect/certs",
      "rolePath": "realm_access.roles",
      "issuerPattern": "^https://keycloak\\.localtest\\.me:8443/realms/dial-dev$"
    }
  },
  "encryption": {
    "secret": "salt",
    "key": "password"
  },
  "applications": {
    "includeCustomApps": true
  },
  "access": {
    "admin": {
      "rules": [
        { "function": "EQUAL", "source": "roles", "targets": ["admin"] }
      ]
    }
  }
}
