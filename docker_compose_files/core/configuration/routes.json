{
  "routes": {
    "quick_apps2": {
      "paths": ["/v1/quickapps_2(/[^/]+)*$"],
      "rewritePath": true,
      "methods": ["GET", "POST", "HEAD"],
      "upstreams": [
        {
          "endpoint": "http://docker.host.internal:5000/v1"
        }
      ]
    },
    "memory": {
      "paths": ["/v1(/memory.*)$"],
      "rewritePath": true,
      "methods": ["GET", "DELETE"],
      "upstreams": [
        {
          "endpoint": "http://memory:8000"
        }
      ]
    }
  }
}
