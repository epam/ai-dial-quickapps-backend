\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":14,\"type\":\"text/markdown\",\"title\":\"bestkievguide.com\",\"data\":\"In one hand, the female figure holds a 16-meter sword, and in the other, a shield measuring 13 by 8 meters.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHXj2Po8kunxiFCSJgpmTNKXSIVO6qJEZNebhjfSVeAu5fHx_4xEg85R3h1h5HQFwrWnncjF8SeS8Dm1qT_xyTxXmSQ1ybdjhlgoOjLo5LIWhgOVCk278YlLxZEa9yJEHBAVVpoDBUVOH_z94_Syhzaj7xMEs_O_h53y4Ap87sKp6MivlbmPU6NBvlx6NLo8A==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":15,\"type\":\"text/markdown\",\"title\":\"bestkievguide.com\",\"data\":\"Initially a symbol of Soviet ideology, the monument has been recontextualized in modern Ukraine.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHXj2Po8kunxiFCSJgpmTNKXSIVO6qJEZNebhjfSVeAu5fHx_4xEg85R3h1h5HQFwrWnncjF8SeS8Dm1qT_xyTxXmSQ1ybdjhlgoOjLo5LIWhgOVCk278YlLxZEa9yJEHBAVVpoDBUVOH_z94_Syhzaj7xMEs_O_h53y4Ap87sKp6MivlbmPU6NBvlx6NLo8A==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":16,\"type\":\"text/markdown\",\"title\":\"bestkievguide.com\",\"data\":\"In a significant act of decommunization, the Soviet coat of arms on the shield was replaced with the Ukrainian trident in 2023.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHXj2Po8kunxiFCSJgpmTNKXSIVO6qJEZNebhjfSVeAu5fHx_4xEg85R3h1h5HQFwrWnncjF8SeS8Dm1qT_xyTxXmSQ1ybdjhlgoOjLo5LIWhgOVCk278YlLxZEa9yJEHBAVVpoDBUVOH_z94_Syhzaj7xMEs_O_h53y4Ap87sKp6MivlbmPU6NBvlx6NLo8A==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":17,\"type\":\"text/markdown\",\"title\":\"ukraine.ua\",\"data\":\"In a significant act of decommunization, the Soviet coat of arms on the shield was replaced with the Ukrainian trident in 2023.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHm3EOK6vgrNWuSYEnrsDLjnDZUtI8lI_D4KiURWWmaZJ3P4NInT9oOQUxgcKCa2kGEEQ6ffJLbpqicFe5LbQvEevEmWRvnThNO-NNbVSErPNiTVVNtqIyz7Pi6jA47Yx3s-PvVvJ1WXpD3YrkGidaoVLZH1_weaYJarWN3_GH61ioylQCf\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":18,\"type\":\"text/markdown\",\"title\":\"metinvestholding.com\",\"data\":\"The monument, which is part of the National Museum of the History of Ukraine in World War II, offers observation decks with panoramic views of Kyiv.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFQ5HuU0kOrO-jueoIt3TBLkchGTEeFevwGjNQQ0wehAM9movqaXagAs3oh7e033LK1PYLIXBPgeJ4nVWJk-wtMzo6_Z9QRdQrlfUSQmyi2ydr-staP-JO1bCUpi92uudY3LRbrp9ggsvQTcRNQ_QPPyFOOaGcQ0xrOjuwNCLzJ1-6t_LWCJ_r9KeAkAy5bSz9KGPytBTabxvifnd94bdJVqjN5iHi4zIA=\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":19,\"type\":\"text/markdown\",\"title\":\"ukraine.ua\",\"data\":\"The monument, which is part of the National Museum of the History of Ukraine in World War II, offers observation decks with panoramic views of Kyiv.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHm3EOK6vgrNWuSYEnrsDLjnDZUtI8lI_D4KiURWWmaZJ3P4NInT9oOQUxgcKCa2kGEEQ6ffJLbpqicFe5LbQvEevEmWRvnThNO-NNbVSErPNiTVVNtqIyz7Pi6jA47Yx3s-PvVvJ1WXpD3YrkGidaoVLZH1_weaYJarWN3_GH61ioylQCf\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":20,\"type\":\"text/markdown\",\"title\":\"encyclopediaofukraine.com\",\"data\":\"The Dnipro River is the vital waterway of Kyiv and the third largest in Europe.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG3d05J9wbk3D6qkqaYLdxoOp7u7UNs8ZSnUzn2G1_Hho1qi2WrUtkkL6mhAE4E8EgO7oemiikC1TWkts8trYIJIjLGiHtZkj7IfP9tOrsNpAjxctsUsMr78KrI7Gzxt47rxtNmCySVhRpK3TIUn5Rq0CinBsMcZEWGRVAncBYD91h2W9kXVr5BJhKKiJJqWQXm7-2y\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":21,\"type\":\"text/markdown\",\"title\":\"kyivcity.gov.ua\",\"data\":\"Historically, it was a crucial part of the trade route \\\"from the Varangians to the Greeks\\\" and was central to the development of the powerful medieval state of Kyivan Rus'.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGf2aSvJj5Tlrs7VrOWPGomKqcP8IF3vrtz_viZOCpbBWJKfEVXpC2LuqJDuzc97xntvLwIkrN3xCVz21DHUjrcz1g_-pdELnruR2ALIfqWktJ2Ra1VNZ_JGF85LKOUBOn46laWLEoEqVamtlLuV4Y=\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":22,\"type\":\"text/markdown\",\"title\":\"encyclopediaofukraine.com\",\"data\":\"Historically, it was a crucial part of the trade route \\\"from the Varangians to the Greeks\\\" and was central to the development of the powerful medieval state of Kyivan Rus'.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG3d05J9wbk3D6qkqaYLdxoOp7u7UNs8ZSnUzn2G1_Hho1qi2WrUtkkL6mhAE4E8EgO7oemiikC1TWkts8trYIJIjLGiHtZkj7IfP9tOrsNpAjxctsUsMr78KrI7Gzxt47rxtNmCySVhRpK3TIUn5Rq0CinBsMcZEWGRVAncBYD91h2W9kXVr5BJhKKiJJqWQXm7-2y\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":23,\"type\":\"text/markdown\",\"title\":\"wikipedia.org\",\"data\":\"The river flows through the heart of the city, dividing it into the historic right bank and the more modern left bank.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH3nGD5jpQ2HI1G3R6i8m_Sdu1ChP0XCfCYqhwdJuDfs9JTJNNg5-NiwgD8Qp8VHiw2KZdNq6sUk6sDqmV0d8uQNjgeBTbw58X_vQcmtAU-HHHt6HZDzqZVBqelqg==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":24,\"type\":\"text/markdown\",\"title\":\"kyivcity.gov.ua\",\"data\":\"The broad expanse of the Dnipro is a defining feature of Kyiv's landscape, offering extensive sandy beaches, numerous islands, and bustling port facilities.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGf2aSvJj5Tlrs7VrOWPGomKqcP8IF3vrtz_viZOCpbBWJKfEVXpC2LuqJDuzc97xntvLwIkrN3xCVz21DHUjrcz1g_-pdELnruR2ALIfqWktJ2Ra1VNZ_JGF85LKOUBOn46laWLEoEqVamtlLuV4Y=\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":25,\"type\":\"text/markdown\",\"title\":\"wikipedia.org\",\"data\":\"The broad expanse of the Dnipro is a defining feature of Kyiv's landscape, offering extensive sandy beaches, numerous islands, and bustling port facilities.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH3nGD5jpQ2HI1G3R6i8m_Sdu1ChP0XCfCYqhwdJuDfs9JTJNNg5-NiwgD8Qp8VHiw2KZdNq6sUk6sDqmV0d8uQNjgeBTbw58X_vQcmtAU-HHHt6HZDzqZVBqelqg==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":26,\"type\":\"text/markdown\",\"title\":\"wikipedia.org\",\"data\":\"The river is not only a key element of the city's economy and transportation but also a cherished symbol of the Ukrainian nation, even being mentioned in the national anthem.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEvQADKdVR7MUyKh52NX5wPT9alocrFZ_rwCkwhr6QizRZNxGUQZANOzyOmzZI2M6evsfjVa3_g8ioQmsZ88vRLSVdqdLOGv7wJ0b4CPcoz-kVTanaYOiyYzmSCNLnL3w==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":27,\"type\":\"text/markdown\",\"title\":\"youtube.com\",\"data\":\"The river is not only a key element of the city's economy and transportation but also a cherished symbol of the Ukrainian nation, even being mentioned in the national anthem.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFN03xYu3wPematDyzk82FmmF7zzf2DrGD2GM7KH_-9MDmnzUXR1MOXUgk2kMFaYS02E_W6Ld4gw2q3qVTo2pDlN-JNuHEZ4k1oNQsqAyTZew5eVEB0GAMXRxLA2cDLadYOfT3iXg==\",\"reference_type\":\"text/markdown\"}]}},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{\"content\":\"\"},\"finish_reason\":null,\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":null}\n\ndata: {\"id\":\"661da4fc-4f9c-472e-b119-d5ccd5a1b3b4\",\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\",\"index\":0}],\"created\":1759326539,\"model\":\"gemini-2.5-pro\",\"object\":\"chat.completion.chunk\",\"usage\":{\"completion_tokens\":905,\"prompt_tokens\":20,\"total_tokens\":925}}\n\ndata: [DONE]\n\n",
