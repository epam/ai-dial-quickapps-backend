  "body": "data: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"role\":\"assistant\"}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"state\":{\"repository_digest\":{\"version\":\"3ac49b7-dirty\",\"status\":\"D generate_json_schema.py\"},\"config_digest\":{\"app_config_path\":\"/config/azure_description.yaml\",\"configuration\":{\"ignore_document_loading_errors\":false,\"use_profiler\":false,\"log_document_links\":false,\"download\":{\"timeout_seconds\":30,\"connect_timeout_seconds\":30},\"check_access\":{\"timeout_seconds\":30,\"connect_timeout_seconds\":30},\"indexing\":{\"parser\":{\"max_document_text_size\":5242880,\"unstructured_chunk_size\":1000},\"multimodal_index\":null,\"description_index\":{\"llm\":{\"deployment_name\":\"gpt-4.1-mini-2025-04-14\",\"max_prompt_tokens\":0,\"max_retries\":1000000000,\"temperature\":0.0},\"estimated_task_tokens\":4000,\"time_limit_multiplier\":1.5,\"min_time_limit_sec\":300.0}},\"qa_chain\":{\"chat_chain\":{\"llm\":{\"deployment_name\":\"gpt-4.1-2025-04-14\",\"max_prompt_tokens\":16000,\"max_retries\":2,\"temperature\":0.0},\"system_prompt_template_override\":null,\"use_history\":true,\"num_page_images_to_use\":4,\"page_image_size\":1536},\"query_chain\":{\"llm\":{\"deployment_name\":\"gpt-4.1-2025-04-14\",\"max_prompt_tokens\":8000,\"max_retries\":2,\"temperature\":0.0},\"use_history\":true}},\"request\":{\"type\":\"rag\",\"force_indexing\":false,\"allow_indexing\":true,\"save_index_on_migration\":true,\"ignore_file_modification\":false}},\"from_custom_configuration\":{},\"from_commands\":{}}}}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":0,\"name\":\"Access document 'ontologies.pdf'\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":0,\"name\":\" [0.01s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":0,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":1,\"name\":\"Load indexes for 'ontologies.pdf'\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":1,\"content\":\"Number of chunks: 296\\n\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":1,\"content\":\"Total text size: 85.4 KiB\\n\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":1,\"name\":\" [0.15s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":1,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":2,\"name\":\"Prepare indexes for search\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":2,\"name\":\" [0.02s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":2,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":3,\"name\":\"Standalone question\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":3,\"content\":\"List the tools to use when working with ontologies. Extract the names of tools mentioned.\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":3,\"name\":\" [0.00s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":3,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"name\":\"Combined search\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"name\":\"Embeddings search\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"name\":\"Keywords search\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"name\":\"Page image search\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":0,\"type\":\"text/markdown\",\"title\":\"[0.89] ontologies.pdf\",\"data\":\"of fatal \\ufb02aws that could jeopardize accuracy. Checks are performed automatically during very speci\\ufb01c stages of the ontology\\u2019s life, such as when it is loaded, when text \\ufb01elds are changed and while using the Text Editor, that also keeps track of feedback on the actions taken. There are many di\\ufb00erent control studies, that range from the examination of the name of terms and associated IDs, to glancing for synonyms and dis- junction features. If a user needs to manually engage with the program control system he must utilize the Veri\\ufb01cation Manager. The window contains a list of all kinds of inspection allowed. Finally, we mention the idea of a cross product, also present in Prot\\u00e9g\\u00e9 and Swoop, but with a somewhat di\\ufb00erent meaning in this situation. In OBO-Edit Cross Prod- uct represents the intersection or relations among the classes that ensure the identi\\ufb01cation of all the hierarchical correspondences within the on- tology. In Prot\\u00e9g\\u00e9 and Swoop,\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=6\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":1,\"type\":\"text/markdown\",\"title\":\"[0.78] ontologies.pdf\",\"data\":\"Swoop has Blackbox, a method to diagnose entities. Reasoners are tasked to develop a set of domains, in this method; the ontology struc- ture is used to pinpoint a problem\\u2019s root cause. In case of con\\ufb02ict, the program displays the event reason in the o\\ufb00ending entity description \\ufb01eld with the use of a semi-formal language and the insertion of some accountable axioms. Here, we can use the Run Debug Tests, Debugging / Explanation, and Repair Ontology commands in the Advanced tab. We can use Version Control to maintain our ontologies appropriately and to verify that their entities are used correctly. This tool o\\ufb00ers two sorts of operations, changelogs and checkpoints; it allows users to keep vari- ous iterations of the same ontology. Changelogs describe the ontology\\u2019s evolutionary route and list changes and adjustments in chronological order. Checkpoints provide quick switching between versions, showcas- ing the range of current models. Swoop supports all RDFS/OWL rela- tional constructs\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=6\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":2,\"type\":\"text/markdown\",\"title\":\"[0.229] ontologies.pdf\",\"data\":\"equipped with the capability to shape and combine various ontologies, thus ensuring the potential of developing shared and reusable informa- tion archives. Swoop\\u2019s predisposition to integration is less clear; it fol- lows di\\ufb00erent principles. It has commands for the fusion of ontologies, but developers were mainly concerned with operations for the reuse of contents within the same ontology: the Swoop \\u201cResource Holder \\u201d tool. OBO-Edit integrations also regard contents in the same ontology. On- toStudio allows the development and maintenance of ontologies by us- ing graphical means, based on client/server architecture. In OntoStudio the ontologies are managed in a central server and users can access and redesign the ontologies. TopBraid Composer (FE) may use in a single user mode working with ontologies stored as \\ufb01les or in a database.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=8\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":3,\"type\":\"text/markdown\",\"title\":\"[0.92] ontologies.pdf\",\"data\":\"3.8. Software comparison\\n\\nWe now provide a general ODEs comparison. Table 3 collects gen- eral discussed tools features. Table 4 collects tools aspects of Usability, Scalability, Stability, Integration, Documentation and Originality. Each characteristic is evaluated with a score ranging from a minimum of 1 to a maximum of 3 yellow stars.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=7\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":4,\"type\":\"text/markdown\",\"title\":\"[0.9] ontologies.pdf\",\"data\":\"the art in ontologies, as well as the meth- ods and challenges on semi-automatic and automatic ontology genera- tion, have been widely examined by various articles [19\\u201323] , over the past few years. Publications on this topic have not presented, so far, a list of biomedical ontologies and open-source bioinformatics databases, also considering an overview of the ontology development tools (ODEs) needed for their investigation and comparing them. In this paper, we investigated the landscape of ontologies in the \\ufb01eld of life sciences,\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=1\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":5,\"type\":\"text/markdown\",\"title\":\"[0.282] ontologies.pdf\",\"data\":\"reference manual. 1992.\\n\\n[108] Farquhar A, Fikes R, Rice J. The ontolingua server: A tool for collaborative ontology\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=12\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"attachments\":[{\"index\":6,\"type\":\"text/markdown\",\"title\":\"[0.73] ontologies.pdf\",\"data\":\"The OWL ontology browser and editor called Swoop [30] was cre- ated at the American University of Maryland. The W3C website, de- scribed it as a compact and straightforward ontology editor, fully im- plemented and accessible for OWL. It has a web-oriented approach and includes many common browser features: address bar, history buttons, bookmarks and hypertext navigation. The primary panel of the appli- cation, which is divided into two tabs, is where most of the work is done. The Ontology Info panel provides general details about it, such as name, annotations, entity counts, and statistics on entity traits. The Species Validation panel depicts each entity and describes its traits or the nature it assumed in the ontology (class, property or individual). Three di\\ufb00erent display options are available for the ontology entities. One can create a comprehensive list of all existing entities, arranged alphabeti- cally, or can examine class or attribute hierarchies, proposed with a tree\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=5\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"name\":\" [0.00s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":6,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":0,\"type\":\"text/markdown\",\"title\":\"[0.63] ontologies.pdf\",\"data\":\"OntoStudio 3.2.0 [27] has been the widely used and accepted tool for building and maintaining ontologies a few years ago [106] . Its prede- cessor version was called OntoEdit [131] . It is a multilingual editor and ontology modeler with a lot of customization options. French, English and German are the languages that can de\\ufb01ne synonyms. Classes, prop- erties, rules, queries and mapping are all part of it. This editor supports the OWL, RDF and ObjectLogic formats [27] . When starting a project, users have the option to choose their preferred storage type, includ- ing internal repositories or a collaborative server. Di\\ufb00erent \\ufb01le formats, such as xml, html, doc, ppt, pdf and postscript, can store data. With the use of a query builder, it provides the option to get data from databases, such as a SQL database. The availability of Query Builder SQL makes it simple to design queries. An external OntoStudio support tool called On- toBroker uses ObjectLogic and SPARQL to query the graph. SPARQL\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=5\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":1,\"type\":\"text/markdown\",\"title\":\"[0.230] ontologies.pdf\",\"data\":\"3.8.5. Documentation\\n\\nThe Prot\\u00e9g\\u00e9 user manual is relatively straightforward; it contains an introduction that explains all theoretical and conceptual aspects of ontologies and languages for the semantic web. This site has produced good, comprehensive updated work, becoming thus a great resource for all Prot\\u00e9g\\u00e9 users. Swoop, OntoStudio and TopBraid Composer (FE) ed- itors provide documentation ontology and ontology libraries. A user\\u2019s guide to the program is provided by Fluent Editor, VonBench and OBO- Edit. The huge and well-organized materials are made possible by frame- works with hypertext links.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=8\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":2,\"type\":\"text/markdown\",\"title\":\"[0.242] ontologies.pdf\",\"data\":\"of formal axioms and rules, knowledge acquisition and the documentation processes are important stages throughout the whole ontology building life cycle, as well as the evaluation process. It aims at guaranteeing a higher degree of consistency and robustness of the conceptualization and must be enhanced. Moreover, there aren\\u2019t many technologies available to assist in knowledge extraction from a\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":3,\"type\":\"text/markdown\",\"title\":\"[0.52] ontologies.pdf\",\"data\":\"3.1. Prot\\u00e9g\\u00e9\\n\\nThe Stanford Center for Biomedical Informatics Research developed Prot\\u00e9g\\u00e9 [128] , an open-source ontology editor and knowledge store. It is a suitable instrument for editing ontologies since it gives users a thorough understanding of the OWL ontology structure. In the current landscape of ontology editors, it is the most complete and popular op- tion. The National Institute of General Medical Sciences supports it as a national resource for biomedical ontologies and knowledge bases. We list some activity modules below.\\n\\n1 Active ontology: enables the development of a brand-new ontology or the opening of an existing one by specifying the directory that it addresses (ontology IRI) or the URI (Ontology Version IRI). The associated source codes in the RDF/XML and OWL/XML languages can be examined and we can reorganize this data.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=4\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":4,\"type\":\"text/markdown\",\"title\":\"[0.241] ontologies.pdf\",\"data\":\"The paper goal is to provide a sign of the evolution of ontology en- gineering over the years. Owing to space restrictions, only some of the major ontology engineering topics could be covered. We hope that the paper can also act as a starting point for a newcomer in the ontology \\ufb01eld and a quick reference for experienced academics. Ontologies are being used in a variety of \\ufb01elds, that range from healthcare, to engi- neering and to \\ufb01nance, because of the past decades research and devel- opment activities. The Web evolution is unstoppable; from a rigid and static structure, it is being transformed into an increasingly dynamic and \\ufb02exible container of information, simulating an eager human in- telligence. In this scenario, ontologies and editors make up indispens- able bases to plan a new era of \\u201cknowledge representation \\u201d. Ontology has been built to organize knowledge that is being generated from the conduction of systematic reviews, studies, and research. The develop- ment of de\\ufb01nitions\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":5,\"type\":\"text/markdown\",\"title\":\"[0.245] ontologies.pdf\",\"data\":\"Fig. 7. OntoGraph relationships.\\n\\ngeneral characteristics and common knowledge regarding experimental studies, as well as to allow the communication among users, opening the opportunity to explore e-science concepts into the LS experimenta- tion domain. Potential future research directions would be to automate the process of creating the ontology. Beyond the creation of new on- tologies, another challenging area of work in the subject of ontologies is the evolution and mapping of current ontologies. Due to the cost of cre- ation, abstraction, and reusability, this is signi\\ufb01cant. Di\\ufb00erent types of ontologies can be derived from a core ontology to suit particular appli-\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=10\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"attachments\":[{\"index\":6,\"type\":\"text/markdown\",\"title\":\"[0.8] ontologies.pdf\",\"data\":\"Ontologies are increasingly being employed to enhance understand- ing and transferability of knowledge in Life Science [1\\u20137] . Research groups are interested in developing ontologies [8] to arrange and con- nect data into searchable libraries [ 9 , 10 ], to establish frameworks of essential concepts (e.g., OWS framework [11] ), to share information, to use knowledge to minimize confusion [12] and to allocate the grow- ing volume and data multiplicity in biomedical research, chemistry, medicine, genomics, biology and pharmacology [13] . Further reasons for appreciating its utility are a wider understanding of the value of standardized vocabularies and codi\\ufb01ed semantics in various domains [8] and the development or extension of construction tools. To enable widespread access [14] and give users the ability to publish, explore, create and update, a few works have been published regarding pro- cedures [15\\u201318] plans, criteria, activities and methodologies adapted to build them. The state of\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=1\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"name\":\" [0.01s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":5,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":0,\"type\":\"text/markdown\",\"title\":\"[0.232] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":1,\"type\":\"text/markdown\",\"title\":\"[0.233] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":2,\"type\":\"text/markdown\",\"title\":\"[0.234] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":3,\"type\":\"text/markdown\",\"title\":\"[0.235] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":4,\"type\":\"text/markdown\",\"title\":\"[0.236] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":5,\"type\":\"text/markdown\",\"title\":\"[0.237] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"attachments\":[{\"index\":6,\"type\":\"text/markdown\",\"title\":\"[0.238] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"name\":\" [0.03s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":7,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":0,\"type\":\"text/markdown\",\"title\":\"[0.63] ontologies.pdf\",\"data\":\"OntoStudio 3.2.0 [27] has been the widely used and accepted tool for building and maintaining ontologies a few years ago [106] . Its prede- cessor version was called OntoEdit [131] . It is a multilingual editor and ontology modeler with a lot of customization options. French, English and German are the languages that can de\\ufb01ne synonyms. Classes, prop- erties, rules, queries and mapping are all part of it. This editor supports the OWL, RDF and ObjectLogic formats [27] . When starting a project, users have the option to choose their preferred storage type, includ- ing internal repositories or a collaborative server. Di\\ufb00erent \\ufb01le formats, such as xml, html, doc, ppt, pdf and postscript, can store data. With the use of a query builder, it provides the option to get data from databases, such as a SQL database. The availability of Query Builder SQL makes it simple to design queries. An external OntoStudio support tool called On- toBroker uses ObjectLogic and SPARQL to query the graph. SPARQL\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=5\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":1,\"type\":\"text/markdown\",\"title\":\"[0.89] ontologies.pdf\",\"data\":\"of fatal \\ufb02aws that could jeopardize accuracy. Checks are performed automatically during very speci\\ufb01c stages of the ontology\\u2019s life, such as when it is loaded, when text \\ufb01elds are changed and while using the Text Editor, that also keeps track of feedback on the actions taken. There are many di\\ufb00erent control studies, that range from the examination of the name of terms and associated IDs, to glancing for synonyms and dis- junction features. If a user needs to manually engage with the program control system he must utilize the Veri\\ufb01cation Manager. The window contains a list of all kinds of inspection allowed. Finally, we mention the idea of a cross product, also present in Prot\\u00e9g\\u00e9 and Swoop, but with a somewhat di\\ufb00erent meaning in this situation. In OBO-Edit Cross Prod- uct represents the intersection or relations among the classes that ensure the identi\\ufb01cation of all the hierarchical correspondences within the on- tology. In Prot\\u00e9g\\u00e9 and Swoop,\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=6\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":2,\"type\":\"text/markdown\",\"title\":\"[0.232] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":3,\"type\":\"text/markdown\",\"title\":\"[0.230] ontologies.pdf\",\"data\":\"3.8.5. Documentation\\n\\nThe Prot\\u00e9g\\u00e9 user manual is relatively straightforward; it contains an introduction that explains all theoretical and conceptual aspects of ontologies and languages for the semantic web. This site has produced good, comprehensive updated work, becoming thus a great resource for all Prot\\u00e9g\\u00e9 users. Swoop, OntoStudio and TopBraid Composer (FE) ed- itors provide documentation ontology and ontology libraries. A user\\u2019s guide to the program is provided by Fluent Editor, VonBench and OBO- Edit. The huge and well-organized materials are made possible by frame- works with hypertext links.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=8\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":4,\"type\":\"text/markdown\",\"title\":\"[0.78] ontologies.pdf\",\"data\":\"Swoop has Blackbox, a method to diagnose entities. Reasoners are tasked to develop a set of domains, in this method; the ontology struc- ture is used to pinpoint a problem\\u2019s root cause. In case of con\\ufb02ict, the program displays the event reason in the o\\ufb00ending entity description \\ufb01eld with the use of a semi-formal language and the insertion of some accountable axioms. Here, we can use the Run Debug Tests, Debugging / Explanation, and Repair Ontology commands in the Advanced tab. We can use Version Control to maintain our ontologies appropriately and to verify that their entities are used correctly. This tool o\\ufb00ers two sorts of operations, changelogs and checkpoints; it allows users to keep vari- ous iterations of the same ontology. Changelogs describe the ontology\\u2019s evolutionary route and list changes and adjustments in chronological order. Checkpoints provide quick switching between versions, showcas- ing the range of current models. Swoop supports all RDFS/OWL rela- tional constructs\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=6\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":5,\"type\":\"text/markdown\",\"title\":\"[0.233] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":6,\"type\":\"text/markdown\",\"title\":\"[0.242] ontologies.pdf\",\"data\":\"of formal axioms and rules, knowledge acquisition and the documentation processes are important stages throughout the whole ontology building life cycle, as well as the evaluation process. It aims at guaranteeing a higher degree of consistency and robustness of the conceptualization and must be enhanced. Moreover, there aren\\u2019t many technologies available to assist in knowledge extraction from a\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":7,\"type\":\"text/markdown\",\"title\":\"[0.229] ontologies.pdf\",\"data\":\"equipped with the capability to shape and combine various ontologies, thus ensuring the potential of developing shared and reusable informa- tion archives. Swoop\\u2019s predisposition to integration is less clear; it fol- lows di\\ufb00erent principles. It has commands for the fusion of ontologies, but developers were mainly concerned with operations for the reuse of contents within the same ontology: the Swoop \\u201cResource Holder \\u201d tool. OBO-Edit integrations also regard contents in the same ontology. On- toStudio allows the development and maintenance of ontologies by us- ing graphical means, based on client/server architecture. In OntoStudio the ontologies are managed in a central server and users can access and redesign the ontologies. TopBraid Composer (FE) may use in a single user mode working with ontologies stored as \\ufb01les or in a database.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=8\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":8,\"type\":\"text/markdown\",\"title\":\"[0.234] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":9,\"type\":\"text/markdown\",\"title\":\"[0.52] ontologies.pdf\",\"data\":\"3.1. Prot\\u00e9g\\u00e9\\n\\nThe Stanford Center for Biomedical Informatics Research developed Prot\\u00e9g\\u00e9 [128] , an open-source ontology editor and knowledge store. It is a suitable instrument for editing ontologies since it gives users a thorough understanding of the OWL ontology structure. In the current landscape of ontology editors, it is the most complete and popular op- tion. The National Institute of General Medical Sciences supports it as a national resource for biomedical ontologies and knowledge bases. We list some activity modules below.\\n\\n1 Active ontology: enables the development of a brand-new ontology or the opening of an existing one by specifying the directory that it addresses (ontology IRI) or the URI (Ontology Version IRI). The associated source codes in the RDF/XML and OWL/XML languages can be examined and we can reorganize this data.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=4\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":10,\"type\":\"text/markdown\",\"title\":\"[0.92] ontologies.pdf\",\"data\":\"3.8. Software comparison\\n\\nWe now provide a general ODEs comparison. Table 3 collects gen- eral discussed tools features. Table 4 collects tools aspects of Usability, Scalability, Stability, Integration, Documentation and Originality. Each characteristic is evaluated with a score ranging from a minimum of 1 to a maximum of 3 yellow stars.\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=7\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":11,\"type\":\"text/markdown\",\"title\":\"[0.235] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":12,\"type\":\"text/markdown\",\"title\":\"[0.241] ontologies.pdf\",\"data\":\"The paper goal is to provide a sign of the evolution of ontology en- gineering over the years. Owing to space restrictions, only some of the major ontology engineering topics could be covered. We hope that the paper can also act as a starting point for a newcomer in the ontology \\ufb01eld and a quick reference for experienced academics. Ontologies are being used in a variety of \\ufb01elds, that range from healthcare, to engi- neering and to \\ufb01nance, because of the past decades research and devel- opment activities. The Web evolution is unstoppable; from a rigid and static structure, it is being transformed into an increasingly dynamic and \\ufb02exible container of information, simulating an eager human in- telligence. In this scenario, ontologies and editors make up indispens- able bases to plan a new era of \\u201cknowledge representation \\u201d. Ontology has been built to organize knowledge that is being generated from the conduction of systematic reviews, studies, and research. The develop- ment of de\\ufb01nitions\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":13,\"type\":\"text/markdown\",\"title\":\"[0.9] ontologies.pdf\",\"data\":\"the art in ontologies, as well as the meth- ods and challenges on semi-automatic and automatic ontology genera- tion, have been widely examined by various articles [19\\u201323] , over the past few years. Publications on this topic have not presented, so far, a list of biomedical ontologies and open-source bioinformatics databases, also considering an overview of the ontology development tools (ODEs) needed for their investigation and comparing them. In this paper, we investigated the landscape of ontologies in the \\ufb01eld of life sciences,\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=1\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":14,\"type\":\"text/markdown\",\"title\":\"[0.236] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":15,\"type\":\"text/markdown\",\"title\":\"[0.245] ontologies.pdf\",\"data\":\"Fig. 7. OntoGraph relationships.\\n\\ngeneral characteristics and common knowledge regarding experimental studies, as well as to allow the communication among users, opening the opportunity to explore e-science concepts into the LS experimenta- tion domain. Potential future research directions would be to automate the process of creating the ontology. Beyond the creation of new on- tologies, another challenging area of work in the subject of ontologies is the evolution and mapping of current ontologies. Due to the cost of cre- ation, abstraction, and reusability, this is signi\\ufb01cant. Di\\ufb00erent types of ontologies can be derived from a core ontology to suit particular appli-\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=10\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":16,\"type\":\"text/markdown\",\"title\":\"[0.282] ontologies.pdf\",\"data\":\"reference manual. 1992.\\n\\n[108] Farquhar A, Fikes R, Rice J. The ontolingua server: A tool for collaborative ontology\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=12\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":17,\"type\":\"text/markdown\",\"title\":\"[0.237] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":18,\"type\":\"text/markdown\",\"title\":\"[0.8] ontologies.pdf\",\"data\":\"Ontologies are increasingly being employed to enhance understand- ing and transferability of knowledge in Life Science [1\\u20137] . Research groups are interested in developing ontologies [8] to arrange and con- nect data into searchable libraries [ 9 , 10 ], to establish frameworks of essential concepts (e.g., OWS framework [11] ), to share information, to use knowledge to minimize confusion [12] and to allocate the grow- ing volume and data multiplicity in biomedical research, chemistry, medicine, genomics, biology and pharmacology [13] . Further reasons for appreciating its utility are a wider understanding of the value of standardized vocabularies and codi\\ufb01ed semantics in various domains [8] and the development or extension of construction tools. To enable widespread access [14] and give users the ability to publish, explore, create and update, a few works have been published regarding pro- cedures [15\\u201318] plans, criteria, activities and methodologies adapted to build them. The state of\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=1\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":19,\"type\":\"text/markdown\",\"title\":\"[0.73] ontologies.pdf\",\"data\":\"The OWL ontology browser and editor called Swoop [30] was cre- ated at the American University of Maryland. The W3C website, de- scribed it as a compact and straightforward ontology editor, fully im- plemented and accessible for OWL. It has a web-oriented approach and includes many common browser features: address bar, history buttons, bookmarks and hypertext navigation. The primary panel of the appli- cation, which is divided into two tabs, is where most of the work is done. The Ontology Info panel provides general details about it, such as name, annotations, entity counts, and statistics on entity traits. The Species Validation panel depicts each entity and describes its traits or the nature it assumed in the ontology (class, property or individual). Three di\\ufb00erent display options are available for the ontology entities. One can create a comprehensive list of all existing entities, arranged alphabeti- cally, or can examine class or attribute hierarchies, proposed with a tree\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=5\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"attachments\":[{\"index\":20,\"type\":\"text/markdown\",\"title\":\"[0.238] ontologies.pdf\",\"data\":\"[Image of the page 9]\",\"reference_url\":\"files/PHhReJdzQbtjwVegSpXV64/ontologies.pdf#page=9\"}],\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"name\":\" [0.03s]\",\"status\":null}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"stages\":[{\"index\":4,\"status\":\"completed\"}]}}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-4abf3df9caca\",\"created\":1770293046,\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"content\":\"\"}}],\"usage\":null,\"id\":\"ff895d0d-8c27-4e7a-9b98-