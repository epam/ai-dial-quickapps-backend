ect\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":20,\"type\":\"text/markdown\",\"title\":\"geeksforgeeks.org\",\"data\":\"*   **High-Level Language:** Python is a high-level language that abstracts away complex hardware details, such as memory management.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFPGlCAVJ4MgrLLz8Lv4VtP-XdDn6rL0O58OScQRwJQFXEh7gROffPL46FeRKZ4HeJg4BINWXAmv5la9Wd3Gf4ARLJgX2mO-jMKFGXoR1-Os2SFwN3XZw8fYCOXvqnhqigTFsrhBOeH-i_A1tMBqxoY\",\"reference_type\":\"text/markdown\"}]}}}],\"usage\":null,\"id\":\"8ca2ae36-6ab6-4a07-b764-f909ec556a4d\",\"created\":1769518220,\"object\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":21,\"type\":\"text/markdown\",\"title\":\"unstop.com\",\"data\":\"*   **High-Level Language:** Python is a high-level language that abstracts away complex hardware details, such as memory management.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGK284HqHPNLVNSbEQvLmWIUy77yPYBJ1bpHcCYimEMLX48vYBIZFA4kdED7l3S7pnKPqKlPU_2TCP8e_xhNPxr_WWNcER_KRFARDonvt_xDV6oM9pCLPYHHxJVbGidBV1zDvxjKw==\",\"reference_type\":\"text/markdown\"}]}}}],\"usage\":null,\"id\":\"8ca2ae36-6ab6-4a07-b764-f909ec556a4d\",\"created\":1769518220,\"object\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":22,\"type\":\"text/markdown\",\"title\":\"unstop.com\",\"data\":\"This allows developers to focus on the logic of their applications rather than low-level intricacies.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGK284HqHPNLVNSbEQvLmWIUy77yPYBJ1bpHcCYimEMLX48vYBI