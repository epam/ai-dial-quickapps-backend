ject\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":12,\"type\":\"text/markdown\",\"title\":\"wikipedia.org\",\"data\":\"He stepped down from this role in 2018, and the project is now led by a five-member Steering Council elected by active Python core developers.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQECsFAkOi7sQfrHH368PMuloVZ-7hbgHAm4CxM4kZ3pUbQQmistthvJWRIttvdqJUospRZf4Qqa2un6NofvuMisJuQXOIf4PxthlwIbMpwoyGUhlyuY-Q1TxufF8nNSgM4EItN80nOYpY-1VV8sAQ-HuiMIxnnl\",\"reference_type\":\"text/markdown\"}]}}}],\"usage\":null,\"id\":\"8ca2ae36-6ab6-4a07-b764-f909ec556a4d\",\"created\":1769518220,\"object\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":13,\"type\":\"text/markdown\",\"title\":\"pythoninstitute.org\",\"data\":\"The Python Software Foundation (PSF), a non-profit organization, now handles the development and distribution of Python's reference implementation.\",\"reference_url\":\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGjwd5WDa5JsC-2Lg0J63XQp9cRTfJ51i85cLmQVLHUT8HbyLLuzb1QiLe6k1O-q5RBXmWD5VHIV4Ll_sUzxNjdAQ2E2w_8_Z6jf0j7wQ5nSMnxD_MyXZb9MGvnrDEj8475Iqo=\",\"reference_type\":\"text/markdown\"}]}}}],\"usage\":null,\"id\":\"8ca2ae36-6ab6-4a07-b764-f909ec556a4d\",\"created\":1769518220,\"object\":\"chat.completion.chunk\",\"model\":\"gemini-2.5-pro\"}\n\ndata: {\"choices\":[{\"index\":0,\"finish_reason\":null,\"delta\":{\"custom_content\":{\"attachments\":[{\"index\":14,\"type\":\"text/markdown\",\"title\":\"wikipedia.org\",\"data\":\"Significant milestones in Python's history include the release of Python 2.0 in 2000, which introduced features like list comprehensions, and the major revision, Python 3.0, in 2008.\",\"reference_url\":\"ht